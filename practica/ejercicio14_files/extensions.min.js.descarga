  }
  .commit-highlight-inner {
    stroke: ${i.primaryColor};
    fill: ${i.primaryColor};
  }

  .arrow { stroke-width: 8; stroke-linecap: round; fill: none}
  .gitTitleText {
    text-anchor: middle;
    font-size: 18px;
    fill: ${i.textColor};
  }
